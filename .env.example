# Copy this file to `.env` and fill in your OWN values. `.env` is git-ignored.
# Never commit real credentials. Values already set in the real environment win
# over this file, so CI/inline overrides work.

# ---------------------------------------------------------------------------
# 1) Front-end build + local CLI tooling
# ---------------------------------------------------------------------------
# Your CloudBase environment ID (a public identifier, safe in front-end code).
# Get it: Tencent Cloud console -> CloudBase (云开发) -> Environments -> Env ID.
# Used at BUILD time (baked into public/vendor/cloudbase.js) and by scripts/sql.cjs
# and scripts/deploy.cjs.
CLOUDBASE_ENV=your-env-id

# CloudBase region, e.g. ap-shanghai / ap-guangzhou / ap-beijing. Default: ap-shanghai.
CLOUDBASE_REGION=ap-shanghai

# ---------------------------------------------------------------------------
# 2) Cloud-function runtime identity (single-user access control)
# ---------------------------------------------------------------------------
# These are set ON THE CLOUD FUNCTION (not exposed to the browser). scripts/deploy.cjs
# reads them from here to configure the function's environment variables; you can also
# set them manually in the console under 云函数 -> math2-api -> 配置 -> 环境变量.
#
# The environment ID again (the function builds its auth-gateway URL from it).
MATH2_ENV_ID=your-env-id
# The ONE allowed account's UID. Console: 身份认证/用户管理 -> your user -> UID.
MATH2_ALLOWED_UID=0000000000000000000
# The ONE allowed account's email; must exactly match the logged-in user's email.
MATH2_ALLOWED_EMAIL=you@example.com
# Optional region override for the function (defaults to ap-shanghai).
MATH2_REGION=ap-shanghai

# ---------------------------------------------------------------------------
# 3) Secret keys — DO NOT PUT THEM HERE
# ---------------------------------------------------------------------------
# TENCENTCLOUD_SECRETID / TENCENTCLOUD_SECRETKEY / TENCENTCLOUD_SESSIONTOKEN are
# injected into the cloud function automatically at runtime by CloudBase. The CLI
# (tcb) authenticates via `npx tcb login`. Secret keys must never appear in .env,
# in the browser bundle, or in version control.

# ---------------------------------------------------------------------------
# Optional: browser tests
# ---------------------------------------------------------------------------
# Channel for Playwright browser tests (default: msedge). e.g. chrome.
# MATH2_BROWSER_CHANNEL=msedge
