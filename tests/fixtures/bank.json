        "stem_md": "函数 $f(x)=x^{3}-3x$ 的极大值为（　）。",
        "options": [
          {
            "id": "opt-a",
            "label": "A",
            "content_md": "$-2$"
          },
          {
            "id": "opt-b",
            "label": "B",
            "content_md": "$0$"
          },
          {
            "id": "opt-c",
            "label": "C",
            "content_md": "$2$"
          },
          {
            "id": "opt-d",
            "label": "D",
            "content_md": "不存在"
          }
        ],
        "answer": {
          "option_ids": [
            "opt-c"
          ]
        },
        "explanation_md": "$f'(x)=3x^{2}-3=0$ 得 $x=\\pm 1$。$f''(x)=6x$，$f''(-1)<0$，故 $x=-1$ 为极大值点，$f(-1)=2$，选 C。"
      },
